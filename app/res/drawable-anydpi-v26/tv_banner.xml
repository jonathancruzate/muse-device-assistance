<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive TV banner, @tv Google TV Figma template structure (adopted
     2026-11-22): separate background + foreground layers in
     drawable-anydpi-v26, legacy ladder PNGs in the drawable-* buckets.
     On pre-26 devices the anydpi-v26 config is ignored and the flat
     density PNGs are the banner. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/tv_banner_background" />
    <foreground android:drawable="@drawable/tv_banner_foreground" />
</adaptive-icon>
